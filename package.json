{
  "name": "seguidores-tempo-real",
  "version": "1.0.0",
  "description": "Contador de seguidores em tempo real (YouTube + Instagram + TikTok)",
  "main": "main.js",
  "author": "Hebert",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --win",
    "build:portable": "electron-builder --win portable",
    "pack": "electron-builder --win --dir"
  },
  "devDependencies": {
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.hebert.seguidores",
    "productName": "Seguidores Tempo Real",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "oauth.js",
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Seguidores Tempo Real"
    }
  }
}
